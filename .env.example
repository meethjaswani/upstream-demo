ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# PORT=3000
# UPSTREAM_MODEL=               model id used with Anthropic keys
# UPSTREAM_OPENROUTER_MODEL=    model id used with OpenRouter keys
